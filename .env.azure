# AfricaGuard — Azure production template (copy values into Container Apps / Static Web Apps)

# Backend (submission_package / Container Apps)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=rg-africaguard-prod
AZURE_ML_WORKSPACE=mlw-africaguard
AZURE_STORAGE_ACCOUNT=stafricaguard
AZURE_STORAGE_CONNECTION_STRING=your-storage-connection-string
FLASK_SECRET_KEY=generate-a-strong-secret
FLASK_ENV=production
AUTH_MODE=b2c
ABUSEIPDB_API_KEY=your-abuseipdb-key
ANTHROPIC_API_KEY=your-claude-api-key
AZURE_ML_ENDPOINT_URL=https://africaguard-endpoint.southafricanorth.inference.ml.azure.com/score
AZURE_ML_ENDPOINT_KEY=get-from-azure-ml-studio
AZURE_B2C_TENANT=africaguard
AZURE_B2C_CLIENT_ID=get-from-b2c-app-registration
VERIFY_B2C_SIGNATURE=false
CORS_ORIGINS=https://africaguard-dashboard.azurestaticapps.net,http://localhost:3000
AFRICAGUARD_CACHE_TTL=45

# Frontend (Static Web Apps / .env.production)
VITE_API_BASE_URL=https://africaguard-api.azurecontainerapps.io/api
VITE_APP_NAME=AfricaGuard
VITE_USE_B2C_AUTH=true
VITE_B2C_CLIENT_ID=get-from-b2c-app-registration
VITE_B2C_TENANT=africaguard
VITE_REDIRECT_URI=https://africaguard-dashboard.azurestaticapps.net/auth/callback
