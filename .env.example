# AfricaGuard — Frontend (local development)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_NAME=AfricaGuard

# Session auth (default — academic demo)
VITE_USE_B2C_AUTH=false

# Azure AD B2C (production — set VITE_USE_B2C_AUTH=true)
# VITE_B2C_CLIENT_ID=your-b2c-app-client-id
# VITE_B2C_TENANT=africaguard
# VITE_B2C_POLICY=B2C_1_signin
# VITE_REDIRECT_URI=http://localhost:3000/auth/callback
